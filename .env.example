# === СЕТЕВЫЕ НАСТРОЙКИ ===
# Укажите 'AUTODETECT' для автоопределения внешнего IP,
# либо пропишите вручную 'localhost' или ваш домен (например, mycam.keenetic.link)
SERVER_IP=AUTODETECT

# Внешний веб-порт, который займет Nginx на сервере (например: 80, 8085, 9000)
WEB_PORT=80

# === БЕЗОПАСНОСТЬ АДМИНИСТРАТОРА ===
# При первой установке введите пароль обычным текстом в поле ADMIN_PASSWORD.
# Скрипт deploy.sh сам захеширует его и превратит в ADMIN_PASSWORD_HASH.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# === ЖЕЛЕЗО И ИНФРАСТРУКТУРА ===
# Путь к системному файлу USB веб-камеры на сервере
DEFAULT_CAMERA=/dev/video0
MAX_LOG_SIZE_MB=10

# Удаленный сервер и сетевые настройки
# Укажите 'AUTODETECT' для автоопределения внешнего IP роутера, 
# либо пропишите вручную 'localhost' или ваш домен (например, mycam.keenetic.link)
SERVER_IP=AUTODETECT
SERVER_PORT=8080

# Безопасность приложения (Вводите пароль обычным текстом)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Инфраструктура
DEFAULT_CAMERA=/dev/video0
